# Porta do servidor web da dashboard
PORT=4178

# ==========================================================
#  MODO DE EXECUÃ‡ÃƒO DO AGENTE
#  OpÃ§Ãµes: mock | paper_mainnet | simulate_rpc | live_mainnet
#   - mock          : dados locais/fake, sem rede (mais seguro)
#   - paper_mainnet : lÃª dados REAIS do mainnet, mas NUNCA envia tx
#   - simulate_rpc  : monta tx real e roda simulateTransaction (nÃ£o comete)
#   - live_mainnet  : NÃƒO SEGURO â€” envia transaÃ§Ãµes reais (custa SOL)
# ==========================================================
AGENT_MODE=paper_mainnet

# Rede padrÃ£o (relevante p/ modos que tocam a rede)
# true=devnet (teste), false=mainnet-beta
USE_DEVNET=false

# Valores obrigatÃ³rios para modos mainnet (paper/simulate/live)
# Use Helius/QuickNode/Triton com chave. NÃƒO use um RPC pÃºblico sem rate limit.
MAINNET_RPC_URL=
MAINNET_WS_URL=

# Programa da Pump.fun (a maioria dos projetos usa este; valide com: npm run validate)
PUMP_FUN_PROGRAM=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P

# ==========================================================
#  TRAVAS DE SEGURANÃ‡A (OBRIGATÃ“RIAS p/ live_mainnet)
# ==========================================================
# NUNCA envie transaÃ§Ãµes reais a menos que:
#   AGENT_MODE=live_mainnet
#   ALLOW_REAL_MODE=true
#   ENABLE_LIVE_TRADING=true
#   I_UNDERSTAND_LIVE_RISK=YES
ALLOW_REAL_MODE=false
ENABLE_LIVE_TRADING=false
REQUIRE_LIVE_CONFIRMATION=true
I_UNDERSTAND_LIVE_RISK=NO
COMMITMENT=confirmed

# ==========================================================
#  PAPER TRADING (modo paper_mainnet)
# ==========================================================
PAPER_INITIAL_SOL=1.0        # Caixa virtual inicial
PAPER_FEE_BPS=100            # Fee simulada (100 = 1%)
PAPER_SLIPPAGE_BPS=50        # Slippage simulada (0.5%)
PAPER_LATENCY_MS=250         # LatÃªncia simulada

# ==========================================================
#  LIMITES DE RISCO (aplicam-se a todos os modos de dados reais)
# ==========================================================
MAX_SOL_PER_TRADE=0.05       # MÃ¡x a gastar por compra
MAX_DAILY_LOSS_SOL=0.20      # MÃ¡x perda diÃ¡ria
MAX_OPEN_POSITIONS=3         # MÃ¡x posiÃ§Ãµes simultÃ¢neas

# --- ParÃ¢metros de trading (sobrescrevÃ­veis pela interface) ---
BUY_AMOUNT_SOL=0.015
SELL_TRIGGER_PCT=10
STOP_LOSS_PCT=15
SLIPPAGE_BPS=500
PRIORITY_FEE_LAMPORTS=10000
